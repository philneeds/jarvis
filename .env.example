# ---- HQ login (single user) ------------------------------------------------
HQ_PASSWORD=change-me                 # required outside dev; gates HQ and the API
HQ_SESSION_SECRET=                    # optional; defaults to HQ_PASSWORD
HQ_ORIGIN=http://localhost:3000       # comma-separated allowed origins for the API
# HQ_RP_ID=hq.example.com             # passkey domain; defaults to the first HQ_ORIGIN hostname

# ---- Storage -----------------------------------------------------------------
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis   # Postgres: memory, log, approvals, usage
# JARVIS_STORE=memory                 # force the JSON file store (data/jarvis.json) even with DATABASE_URL set
# JARVIS_DATA_FILE=data/jarvis.json

# ---- Models ------------------------------------------------------------------
CLAUDE_MODE=agent-sdk                 # agent-sdk = Claude Code sign-in on Phil's plan; api = ANTHROPIC_API_KEY (fallback)
# ANTHROPIC_API_KEY=                  # pay-as-you-go fallback only
CLAUDE_OPUS_MODEL=claude-opus-5-5
CLAUDE_SONNET_MODEL=claude-sonnet-5-5
GROK_MODE=cli                         # cli = `grok -p` on SuperGrok (run `grok login` once); api = XAI_API_KEY (pay per token, xAI credits)
# GROK_AGENTS_MODEL=claude-sonnet     # move every Grok-routed agent (scouts, Lucas's team) onto a Claude model in one line, e.g. after dropping SuperGrok
GROK_BIN=grok
# GROK_ARGS=                         # default: --permission-mode dontAsk --max-turns 8 --output-format json --disallowed-tools <shell,file,media tools> -p
# GROK_CWD=/tmp/jarvis-grok           # the CLI runs in an empty directory so scouts see nothing on the server
# GROK_TIMEOUT_MS=300000
# XAI_API_KEY=                        # turns on real X search for every agent (xAI x_search: about $5 per 1,000 posts read, plus tokens).
                                      # Without it nobody can read X: the Grok CLI has no X search and X blocks its pages for servers.
# XAI_SEARCH_MODEL=grok-4.7           # model for those searches
GROK_MODEL=grok-4
# JARVIS_MOCK=1                       # offline mock providers (dev/demo)
# JARVIS_MOCK_FALLBACK=1              # fall back to the mock when no real provider is available

# ---- Usage rationing ---------------------------------------------------------
CLAUDE_MONTHLY_USD=100                # the Agent SDK credit on Phil's Claude plan per month (Pro 20, Max 5x 100, Max 20x 200)
XAI_MONTHLY_USD=30                    # what HQ may spend at xAI per month (X searches; Grok runs too when GROK_MODE=api)
GROK_WEEKLY_RUNS=400                  # GROK_MODE=cli only: Grok Build CLI runs per week on SuperGrok
THROTTLE_PAUSE_FIRST_AT=0.7
THROTTLE_ROOM_AT=0.9

# ---- Scheduler and notifications ----------------------------------------------
BRIEF_AT=07:00                        # daily brief, on the service's clock (setup.sh sets TZ=America/New_York)
# SCHEDULER=0                         # disable timers
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-private-topic   # approvals and alerts to your phone (ntfy)
# TELEGRAM_BOT_TOKEN=                 # or a Telegram bot…
# TELEGRAM_CHAT_ID=                   # …messaging this chat

# ---- Connectors --------------------------------------------------------------
# GOOGLE_CLIENT_ID=                   # OAuth client (Web application) in Google Cloud; scopes: calendar, gmail readonly/compose/send
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback   # must match the OAuth client

# X_CLIENT_ID=                        # OAuth 2.0 app in the X developer portal (confidential client, PKCE)
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:3000/api/connectors/x/callback

# ---- Server / HQ -------------------------------------------------------------
PORT=4000
API_URL=http://localhost:4000         # where HQ proxies /api
# NEXT_PUBLIC_WS_URL=wss://hq.example.com/ws
NEXT_PUBLIC_CITY=Rochester, NY
NEXT_PUBLIC_LAT=43.16
NEXT_PUBLIC_LON=-77.61

# ---- Voice ---------------------------------------------------------------------
# KUBERA_API_KEY=                     # Munger's Kubera: a read-only key from Kubera Settings > API
# KUBERA_SECRET=
# GHL_API_KEY=                        # JD PM's GoHighLevel: a read-only Private Integration token (sub-account Settings > Private Integrations)
# GHL_LOCATION_ID=                    # the sub-account id (Settings > Business Profile)
# DISCORD_BOT_TOKEN=                  # House's biotech Discord: a bot with View Channels + Read Message History and the Message Content intent
# DISCORD_CHANNELS=                   # label=channelId pairs, comma-separated: "biotech=123456789012345678"
# GITHUB_READ_TOKEN=                  # Jason, Paul, Ansem: a fine-grained token, read-only Contents/Metadata/Issues/Pull requests on the repos Phil shares
# GITHUB_REPOS=                       # optional: "owner/repo,owner/other" to limit what agents see
# OPENAI_API_KEY=                     # voice notes on Telegram: transcription (ElevenLabs key also works, or GROQ_API_KEY for the free tier)
# GROQ_API_KEY=
# BACKUP_DIR=/var/backups/jarvis       # nightly 3:15 am database dump, kept BACKUP_KEEP_DAYS (14); a copy goes to Google Drive when Google is connected
# HEALTHCHECK_URL=                    # downtime alert: a healthchecks.io ping URL; HQ pings it every 5 minutes
# ROBINHOOD_MCP_URL=                  # Robinhood's agent access needs no key: connect it from Settings. Override the server URL only if Robinhood moves it
# SPOTIFY_CLIENT_ID=                  # Lip's Spotify: an app at developer.spotify.com (the owner needs Premium)
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=                # defaults to <HQ_ORIGIN>/api/connectors/spotify/callback
# ELEVENLABS_API_KEY=                 # Jarvis speaks with an ElevenLabs voice; without it HQ uses the device voice
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# VOICE_STRETCH=1.25                  # on top of ELEVENLABS_SPEED for Telegram voice replies (needs ffmpeg): 1.2 x 1.25 = 1.5x
# ELEVENLABS_SPEED=1.2                # 0.7 slow … 1.2 fast (the ElevenLabs ceiling; 1.2 is the default)
# ELEVENLABS_MODEL=eleven_flash_v2_5   # flash answers fastest; eleven_turbo_v2_5 or eleven_multilingual_v2 for polish
# ELEVENLABS_STT_MODEL=scribe_v1       # the same key also transcribes what Phil says (HQ picks the mic he chose)

# ---- Always-on device -----------------------------------------------------------
# PICOVOICE_ACCESS_KEY=               # free key from console.picovoice.ai: HQ wakes on the word "Jarvis"; without it, clap twice
# PHIL_TZ=America/New_York            # times in briefs and the always-on clock
# BRIEF_LEAD_TIMEOUT_MS=180000
