# ---- HQ login (single user) ------------------------------------------------
HQ_PASSWORD=change-me                 # required outside dev; gates HQ and the API
HQ_SESSION_SECRET=                    # optional; defaults to HQ_PASSWORD
HQ_ORIGIN=http://localhost:3000       # comma-separated allowed origins for the API
# HQ_RP_ID=hq.example.com             # passkey domain; defaults to the first HQ_ORIGIN hostname

# ---- Storage -----------------------------------------------------------------
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis   # Postgres: memory, log, approvals, usage
# JARVIS_STORE=memory                 # force the JSON file store (data/jarvis.json) even with DATABASE_URL set
# JARVIS_DATA_FILE=data/jarvis.json

# ---- Models ------------------------------------------------------------------
CLAUDE_MODE=agent-sdk                 # agent-sdk = Claude Code sign-in on Phil's plan; api = ANTHROPIC_API_KEY (fallback)
# ANTHROPIC_API_KEY=                  # pay-as-you-go fallback only
CLAUDE_OPUS_MODEL=claude-opus-5-5
CLAUDE_SONNET_MODEL=claude-sonnet-5-5
GROK_MODE=cli                         # cli = `grok -p` on SuperGrok (run `grok login` once); api = XAI_API_KEY
GROK_BIN=grok
# GROK_ARGS=                         # default: --permission-mode dontAsk --max-turns 8 --output-format json --disallowed-tools <shell,file,media tools> -p
# GROK_CWD=/tmp/jarvis-grok           # the CLI runs in an empty directory so scouts see nothing on the server
# GROK_TIMEOUT_MS=300000
# XAI_API_KEY=
GROK_MODEL=grok-4
# JARVIS_MOCK=1                       # offline mock providers (dev/demo)
# JARVIS_MOCK_FALLBACK=1              # fall back to the mock when no real provider is available

# ---- Usage rationing (estimates until the plans are confirmed) ---------------
CLAUDE_WEEKLY_TOKENS=15000000
GROK_WEEKLY_RUNS=400
THROTTLE_PAUSE_FIRST_AT=0.7
THROTTLE_ROOM_AT=0.9

# ---- Scheduler and notifications ----------------------------------------------
BRIEF_AT=07:00                        # daily brief, server local time
# SCHEDULER=0                         # disable timers
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-private-topic   # approvals and alerts to your phone (ntfy)
# TELEGRAM_BOT_TOKEN=                 # or a Telegram bot…
# TELEGRAM_CHAT_ID=                   # …messaging this chat

# ---- Connectors --------------------------------------------------------------
# GOOGLE_CLIENT_ID=                   # OAuth client (Web application) in Google Cloud; scopes: calendar, gmail readonly/compose/send
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google/callback   # must match the OAuth client

# X_CLIENT_ID=                        # OAuth 2.0 app in the X developer portal (confidential client, PKCE)
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:3000/api/connectors/x/callback

# ---- Server / HQ -------------------------------------------------------------
PORT=4000
API_URL=http://localhost:4000         # where HQ proxies /api
# NEXT_PUBLIC_WS_URL=wss://hq.example.com/ws
NEXT_PUBLIC_CITY=Rochester, NY
NEXT_PUBLIC_LAT=43.16
NEXT_PUBLIC_LON=-77.61
